{
	"name": "javascript-template-action",
	"version": "0.0.0",
	"private": true,
	"description": "JavaScript template action",
	"main": "dist/index.js",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build-release": "bun build src/main.ts --compile --outfile dist/index.js",
		"format": "biome format --write",
		"test": "bun test",
		"dev": "bun run scripts/run-local.ts",
		"start": "bun run src/main.ts"
	},
