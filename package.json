		"@takumi-rs/helpers": "^0.27.6",
		"es-toolkit": "^1.39.10",
		"front-matter": "^3.0.2",
		"marked": "^4.0.10",
		"picomatch": "^3.0.1",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"twemoji": "^12.1.6"
	},
	"devDependencies": {
